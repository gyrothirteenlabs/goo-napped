  m_Script: {fileID: 11500000, guid: a93fb8b1c12a3144591351f4b57a6b75, type: 3}
  m_Name: 
  m_EditorClassIdentifier: GooNapped.Runtime::GooNapped.LevelIntro
  fromCatalog: 0
  goal: {x: 3.5, y: 2.5}
  shots:
  - focus: {x: 21.5, y: 8}
    zoom: 2.2
    moveTime: 0
    hold: 0.35
    speaker: 
    line: The old drain pipe runs straight into the castle cellars. Nobody comes
      down here anymore.
  - focus: {x: 29.5, y: 6.5}
    zoom: 1.3
    moveTime: 1.8
    hold: 0.35
    speaker: 
    line: Down there, a jar is glowing. Someone is trapped inside.
  - focus: {x: 13.5, y: 5.5}
    zoom: 1.4
    moveTime: 1.6
    hold: 0.35
    speaker: 
    line: A golem patrols the lower hall. Never step into its sight.
  - focus: {x: 3.5, y: 2.5}
    zoom: 1.3
    moveTime: 1.3
    hold: 0.35
    speaker: 
    line: And that vent leads out of the cellars.
  afterLines:
  - A small, clear slime. Nobody will notice you... if you're careful.
  entry: 1
  walkIn: {x: 1.6, y: 0}
  lookAround: 1
  playWhenOpenedDirectly: 0
