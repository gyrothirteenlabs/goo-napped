/* Cutscene & dialog gaya intro RPG 16-bit (Zelda SNES), disesuaikan dengan UI dungeon tim (font Pixelify Sans,
   krem 226/214/184, hitam 10/9/12, kuningan 201/160/82, merah tua 122/24/36, tekstur Art/UI/Generated).
   Resolusi acuan panel 640x360 (StoryPanelSettings, mode Expand: seluruh 640x360 selalu muat di layar rasio apa pun). Gambar cerita 224x112 px ditampilkan 2x (448x224) supaya pixel tajam.
   Kotak teks tingginya TETAP (3 baris). Teks panjang dipecah per kalimat oleh StoryPlayer, jadi tidak pernah scroll. */

.story-root {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    -unity-font-definition: url("/Assets/ThirdParty/Fonts/PixelifySans/PixelifySans.ttf");
    color: rgb(226, 214, 184);
}
.story--hidden { display: none; }

.backdrop { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(6, 5, 8); }
.backdrop--hidden { display: none; }

.layout { position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: none; }
.layout--active { display: flex; }

/* ---------- halaman bergambar ---------- */
.layout-cine { flex-direction: column; align-items: center; justify-content: center; }

.cine-frame { width: 460px; height: 236px; flex-shrink: 0; }
.frame-outer {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(10, 9, 12);
    border-width: 2px; border-color: rgb(10, 9, 12);
}
.frame-inner {
    position: absolute; left: 2px; top: 2px; right: 2px; bottom: 2px;
    border-width: 2px; border-color: rgb(201, 160, 82);
}
.cine-image {
    position: absolute; left: 6px; top: 6px; width: 448px; height: 224px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgb(0, 0, 0);
}
.cine-frame--empty { display: none; }
.rivet { position: absolute; width: 6px; height: 6px; background-color: rgb(226, 214, 184); border-width: 1px; border-color: rgb(90, 66, 30); }
.rivet--tl { left: -1px; top: -1px; }
.rivet--tr { right: -1px; top: -1px; }
.rivet--bl { left: -1px; bottom: -1px; }
.rivet--br { right: -1px; bottom: -1px; }

/* ---------- kotak teks (dipakai cutscene dan dialog) ---------- */
.text-box {
    background-color: rgba(12, 10, 16, 0.96);
    border-width: 2px; border-color: rgb(226, 214, 184);
    padding: 14px 18px 10px 18px;
}
.cine-box { width: 460px; height: 92px; margin-top: 12px; flex-shrink: 0; }
.cine-box--hidden { opacity: 0; }

.box-text {
    font-size: 13px;
    white-space: normal;
    letter-spacing: 1px;
    color: rgb(226, 214, 184);
    text-shadow: 1px 1px 0 rgb(10, 9, 12);
    margin: 0; padding: 0;
    -unity-paragraph-spacing: 0;
}

/* nama pembicara: stiker kertas tua di tepi atas kotak */
.speaker-tab {
    position: absolute; left: 12px; top: -11px;
    padding: 1px 8px 2px 8px;
    font-size: 10px; letter-spacing: 1px; -unity-font-style: bold;
    color: rgb(26, 18, 16);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Art/UI/Generated/ui_paper.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 3; -unity-slice-right: 3; -unity-slice-top: 3; -unity-slice-bottom: 3;
}
.speaker-tab--hidden { display: none; }

/* panah lanjut (berkedip) */
.next-arrow { position: absolute; right: 10px; bottom: 8px; width: 10px; height: 8px; }
.next--hidden { display: none; }
.next-a { position: absolute; left: 0; top: 0; width: 10px; height: 2px; background-color: rgb(201, 160, 82); }
.next-b { position: absolute; left: 2px; top: 2px; width: 6px; height: 2px; background-color: rgb(201, 160, 82); }
.next-c { position: absolute; left: 4px; top: 4px; width: 2px; height: 2px; background-color: rgb(201, 160, 82); }

/* ---------- dialog di atas permainan ---------- */
.layout-dialogue { flex-direction: column; justify-content: flex-end; align-items: center; padding-bottom: 14px; }
.dialogue-box { flex-direction: row; align-items: flex-start; width: 520px; height: 84px; padding: 12px 16px 10px 12px; }
.dialogue-col { flex-grow: 1; flex-shrink: 1; height: 100%; }
.speaker-tab--dialogue { left: 0; top: -23px; }
.portrait {
    width: 56px; height: 56px; flex-shrink: 0;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgb(30, 26, 36);
    border-width: 2px; border-color: rgb(201, 160, 82);
}
.portrait--hidden { display: none; }

/* garis hitam sinematik (pembuka level). Tinggi dianimasikan StoryPlayer.SetCinematic */
.cine-bar { position: absolute; left: 0; right: 0; height: 0; background-color: rgb(0, 0, 0); }
.cine-bar--top { top: 0; }
.cine-bar--bottom { bottom: 0; }
/* saat sinematik, kotak dialog naik di atas garis bawah */
.story--cinematic .layout-dialogue { padding-bottom: 40px; }

/* transisi antar halaman (hitam) */
.story-fade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(6, 5, 8); opacity: 0; }

.skip-hint {
    position: absolute; right: 10px; top: 6px;
    font-size: 9px; letter-spacing: 1px;
    color: rgba(226, 214, 184, 0.45);
}
