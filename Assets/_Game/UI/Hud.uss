/* Gaya HUD (14 Nov): tema dungeon gelap + elemen miring ala menu. Resolusi acuan 960x540.
   Nama kelas dipakai GameHud.cs, jangan diganti tanpa mengubah kode. Tampilan final: tim desainer. */

.hud-root {
    flex-grow: 1;
    padding: 10px 12px;
    flex-direction: column;
    color: rgb(186, 178, 164);
    font-size: 12px;
    -unity-font-definition: url("/Assets/ThirdParty/Fonts/PixelifySans/PixelifySans.ttf");
}

.top-row { flex-direction: row; justify-content: space-between; align-items: flex-start; }
.bottom-row { flex-direction: row; justify-content: space-between; align-items: flex-end; }
.spacer { flex-grow: 1; }
.spacer-h { flex-grow: 1; }

/* ---------- kartu slime ---------- */
.sc-card {
    flex-direction: row; align-items: center;
    background-color: rgba(10, 9, 12, 0.9);
    border-width: 2px; border-color: rgb(40, 36, 40);
    border-left-width: 0;
    padding: 8px 14px 8px 18px;
    rotate: -2deg;
    min-width: 280px;
}
.sc-strip { position: absolute; left: 0; top: 0; bottom: 0; width: 6px; background-color: rgb(122, 24, 36); }

/* potret bulat */
.sc-portrait-wrap { width: 76px; height: 76px; }
.sc-portrait {
    width: 76px; height: 76px;
    border-radius: 38px;
    border-width: 3px; border-color: rgb(226, 214, 184);
    background-color: rgb(20, 18, 22);
    overflow: hidden;
    align-items: center; justify-content: flex-end;
}
.sc-glow { position: absolute; left: 0; right: 0; top: 0; bottom: 0; opacity: 0.1; }
.sc-slime {
    width: 104px; height: 104px; margin-bottom: 2px;
    transform-origin: 50% 100%;
    transition-property: scale; transition-duration: 0.25s; transition-timing-function: ease-out-back;
}
.sc-sprite {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}
.sc-mass {
    position: absolute; right: -6px; bottom: -4px;
    font-size: 12px; -unity-font-style: bold;
    color: rgb(10, 9, 12); background-color: rgb(226, 214, 184);
    padding: 0 4px; margin: 0;
    rotate: -6deg;
}

.sc-info { margin-left: 14px; }
.sc-line { flex-direction: row; align-items: center; margin-bottom: 3px; }
.sc-aura-dot { width: 10px; height: 10px; rotate: 45deg; margin-right: 8px; border-width: 1px; border-color: rgb(10, 9, 12); }
.sc-aura { font-size: 18px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(226, 214, 184); margin: 0; padding: 0; }
.sc-key { font-size: 10px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(96, 90, 86); margin: 0 6px 0 0; padding: 0; }
.sc-key--gap { margin-left: 12px; }
.sc-pips { flex-direction: row; }
.sc-pip { width: 8px; height: 10px; margin-right: 3px; background-color: rgb(40, 36, 40); }
.sc-pip--on { background-color: rgb(226, 214, 184); }
.sc-pip--piece { width: 8px; height: 8px; rotate: 45deg; margin-right: 6px; }
.sc-pip--active { background-color: rgb(201, 160, 82); }

/* teman + efek */
.sc-line--fx { margin-top: 2px; flex-wrap: wrap; }
.sc-friend { flex-direction: row; align-items: center; margin-right: 10px; padding-right: 10px; border-right-width: 1px; border-right-color: rgb(40, 36, 40); }
.sc-friend-icon { width: 16px; height: 12px; }
.sc-fi-top { position: absolute; left: 3px; top: 0; width: 10px; height: 2px; background-color: rgb(86, 140, 130); }
.sc-fi-body { position: absolute; left: 0; top: 2px; width: 16px; height: 10px; background-color: rgb(86, 140, 130); }
.sc-fi-eye { position: absolute; top: 5px; width: 2px; height: 3px; background-color: rgb(10, 9, 12); }
.sc-fi-eye--l { left: 5px; }
.sc-fi-eye--r { left: 9px; }
.sc-friend-count { font-size: 14px; -unity-font-style: bold; color: rgb(186, 178, 164); margin: 0 0 0 5px; padding: 0; }
.sc-friend--active .sc-fi-top, .sc-friend--active .sc-fi-body { background-color: rgb(201, 160, 82); }
.sc-friend--active .sc-friend-count { color: rgb(201, 160, 82); }
.sc-effects { flex-direction: row; flex-wrap: wrap; }
.sc-fx { flex-direction: row; align-items: center; margin-right: 10px; }
.sc-fx-dot { width: 6px; height: 6px; margin-right: 4px; }
.sc-fx-name { font-size: 11px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(186, 178, 164); margin: 0; padding: 0; }
.sc-fx--none .sc-fx-name { color: rgb(62, 56, 54); }
.sc-goal { font-size: 11px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(140, 132, 122); margin: 3px 0 0 0; padding: 0; }
.sc-goal--done { color: rgb(86, 140, 130); }
.sc-status { font-size: 10px; color: rgb(96, 90, 86); margin: 1px 0 0 0; padding: 0; white-space: normal; max-width: 220px; }

/* ---------- kartu toples ---------- */
.panel {
    background-color: rgba(10, 9, 12, 0.88);
    border-width: 2px; border-color: rgb(40, 36, 40);
    padding: 6px 10px;
}
.recipes { flex-direction: column; align-items: flex-end; }
.recipe-card { margin-bottom: 6px; min-width: 170px; rotate: 2deg; border-right-width: 6px; border-right-color: rgb(122, 24, 36); }
.recipe-title { -unity-font-style: bold; font-size: 14px; letter-spacing: 1px; color: rgb(226, 214, 184); margin-bottom: 3px; }
.recipe-row { flex-direction: row; align-items: center; }
.recipe-dot { width: 6px; height: 6px; margin-right: 5px; rotate: 45deg; }
.recipe-dot--ok { background-color: rgb(86, 140, 130); }
.recipe-dot--miss { background-color: rgb(170, 52, 52); }
.recipe-text { font-size: 11px; }
.recipe-text--ok { color: rgb(186, 178, 164); }
.recipe-text--miss { color: rgb(140, 132, 122); }
.recipe-note { font-size: 10px; color: rgb(201, 160, 82); margin-top: 3px; }
.recipe-card--done { opacity: 0.55; }

/* ---------- bawah ---------- */
.controls {
    font-size: 10px;
    color: rgba(140, 132, 122, 0.8);
    -unity-text-align: lower-right;
    white-space: normal;
    flex-shrink: 1;
    max-width: 55%;
}

.toast {
    align-self: center;
    background-color: rgba(10, 9, 12, 0.9);
    border-left-width: 4px; border-left-color: rgb(201, 160, 82);
    color: rgb(226, 214, 184);
    padding: 4px 10px;
    margin-bottom: 8px;
    font-size: 13px;
}
.toast--hidden { display: none; }

.banner {
    position: absolute;
    left: -20px; right: -20px; top: 40%;
    -unity-text-align: middle-center;
    font-size: 36px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    background-color: rgba(10, 9, 12, 0.92);
    border-top-width: 3px; border-bottom-width: 3px; border-color: rgb(122, 24, 36);
    padding: 10px;
    rotate: -2deg;
}
.banner--hidden { display: none; }
.banner--win { color: rgb(226, 214, 184); border-color: rgb(86, 140, 130); }
.banner--fail { color: rgb(170, 52, 52); }

/* ================= HUD A: medali besi + pita kain (Figma "HUD & Dungeon") =================
   Tanpa kotak kartu: potret di medali besi berpaku, nama aura di atas pita kain sobek, info melayang. */
.sc-card {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    rotate: 0deg;
    min-width: 0;
    align-items: flex-start;
}
.sc-strip { display: none; }
.sc-ribbon {
    position: absolute; left: 62px; top: 12px; width: 300px; height: 30px;
    background-image: url("../Art/UI/Generated/ui_ribbon.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 2; -unity-slice-right: 12; -unity-slice-top: 0; -unity-slice-bottom: 0;
    rotate: -3deg;
}
.sc-portrait-wrap { width: 104px; height: 104px; }
.sc-medal-shadow { position: absolute; left: 4px; top: 4px; width: 104px; height: 104px; border-radius: 52px; background-color: rgba(6, 5, 7, 0.8); }
.sc-medal-outer { position: absolute; left: 0; top: 0; width: 104px; height: 104px; border-radius: 52px; background-color: rgb(96, 84, 86); border-width: 2px; border-color: rgb(20, 18, 18); }
.sc-medal-inner { position: absolute; left: 8px; top: 8px; width: 88px; height: 88px; border-radius: 44px; background-color: rgb(62, 56, 54); border-width: 2px; border-color: rgb(40, 36, 36); }
.sc-portrait {
    position: absolute; left: 14px; top: 14px; width: 76px; height: 76px;
    border-radius: 38px; border-width: 2px; border-color: rgb(20, 18, 18);
    background-color: rgb(18, 15, 17);
}
.sc-rivet { position: absolute; width: 6px; height: 6px; background-color: rgb(201, 160, 82); border-width: 1px; border-color: rgb(90, 66, 30); }
.sc-rivet--0 { left: 96px; top: 49px; }
.sc-rivet--1 { left: 82px; top: 82px; }
.sc-rivet--2 { left: 49px; top: 96px; }
.sc-rivet--3 { left: 16px; top: 82px; }
.sc-rivet--4 { left: 2px; top: 49px; }
.sc-rivet--5 { left: 16px; top: 16px; }
.sc-rivet--6 { left: 49px; top: 2px; }
.sc-rivet--7 { left: 82px; top: 16px; }
.sc-mass { right: -10px; bottom: -2px; background-color: rgb(203, 189, 152); color: rgb(26, 18, 16); }

.sc-info { margin-left: 18px; margin-top: 14px; }
.sc-aura-dot { display: none; }
.sc-aura { font-size: 20px; text-shadow: 2px 2px 0 rgb(10, 9, 12); rotate: -3deg; margin-bottom: 8px; }
.sc-key { color: rgb(140, 132, 122); text-shadow: 1px 1px 0 rgb(10, 9, 12); }
.sc-fx-name, .sc-friend-count { text-shadow: 1px 1px 0 rgb(10, 9, 12); }
.sc-goal { text-shadow: 1px 1px 0 rgb(10, 9, 12); }
.sc-status { text-shadow: 1px 1px 0 rgb(10, 9, 12); color: rgb(140, 132, 122); }
.sc-friend { border-right-color: rgb(96, 84, 86); }

/* ================= TUTORIAL PROMPT (gaya B, Figma "HUD & Dungeon" > Tutorial) =================
   Melayang di atas slime aktif: keycap pixel + teks ber-outline + bayangan lembut. Dibuat TutorialPrompt.cs. */
.tp-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.tp-prompt {
    position: absolute; left: 0; top: 0;
    flex-direction: column; align-items: center;
    transform-origin: 50% 100%;
}
.tp-shadow {
    position: absolute; left: -40px; right: -40px; top: -26px; bottom: -18px;
    background-image: url("../Art/UI/Generated/ui_glow.png");
    -unity-background-image-tint-color: rgba(0, 0, 0, 0.75);
    -unity-background-scale-mode: stretch-to-fill;
}
.tp-row { flex-direction: row; align-items: flex-end; }
.tp-textbox { margin-bottom: 4px; }
.tp-keys { flex-direction: row; align-items: flex-end; margin-right: 8px; }
.tp-wasd { width: 70px; height: 52px; }
.tp-key { position: absolute; width: 22px; height: 26px; }
.tp-key--inline { position: relative; margin-right: 4px; }
.tp-key-edge { position: absolute; left: 0; right: 0; top: 4px; bottom: 0; background-color: rgb(10, 9, 12); }
.tp-key-side { position: absolute; left: 1px; right: 1px; top: 4px; bottom: 1px; background-color: rgb(106, 98, 90); }
.tp-key-top { position: absolute; left: 0; right: 0; top: 0; height: 22px; background-color: rgb(10, 9, 12); }
.tp-key-face { position: absolute; left: 1px; right: 1px; top: 1px; height: 19px; background-color: rgb(226, 214, 184); }
.tp-key-shine { position: absolute; left: 2px; right: 2px; top: 2px; height: 2px; background-color: rgba(255, 255, 255, 0.45); }
.tp-key-label {
    position: absolute; left: 0; right: 0; top: 1px; height: 19px;
    font-size: 13px; -unity-font-style: bold; color: rgb(10, 9, 12);
    -unity-text-align: middle-center; margin: 0; padding: 0;
}
.tp-key--long .tp-key-label { font-size: 10px; }
/* tombol sedang ditekan: turun 3px, menyala kuningan */
.tp-key--down .tp-key-top, .tp-key--down .tp-key-face, .tp-key--down .tp-key-shine, .tp-key--down .tp-key-label { translate: 0 3px; }
.tp-key--down .tp-key-side { display: none; }
.tp-key--down .tp-key-face { background-color: rgb(201, 160, 82); }
.tp-text {
    font-size: 18px; -unity-font-style: bold; letter-spacing: 2px;
    color: rgb(226, 214, 184);
    text-shadow: 2px 2px 0 rgb(10, 9, 12);
    -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(10, 9, 12);
    margin: 0; padding: 0;
}
.tp-arrow { width: 12px; height: 12px; margin-top: 6px; }
.tp-arrow-a { position: absolute; left: 0; top: 0; width: 12px; height: 4px; background-color: rgb(226, 214, 184); }
.tp-arrow-b { position: absolute; left: 2px; top: 4px; width: 8px; height: 4px; background-color: rgb(226, 214, 184); }
.tp-arrow-c { position: absolute; left: 4px; top: 8px; width: 4px; height: 4px; background-color: rgb(226, 214, 184); }
