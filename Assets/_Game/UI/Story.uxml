<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Cutscene + dialog. Layout di sini, tampilan di Story.uss. Nama elemen dipakai StoryPlayer.cs. -->
    <Style src="Story.uss" />
    <ui:VisualElement name="story-root" class="story-root story--hidden">
        <ui:VisualElement name="backdrop" class="backdrop" />

        <ui:VisualElement name="layout-left" class="layout layout-left">
            <ui:VisualElement name="left-image" class="story-image left-image" />
            <ui:VisualElement name="left-lines" class="lines left-lines" />
        </ui:VisualElement>

        <ui:VisualElement name="layout-top" class="layout layout-top">
            <ui:VisualElement name="top-image" class="story-image top-image" />
            <ui:VisualElement name="top-lines" class="lines top-lines" />
        </ui:VisualElement>

        <ui:VisualElement name="layout-only" class="layout layout-only">
            <ui:VisualElement name="only-image" class="story-image only-image" />
            <ui:VisualElement name="only-lines" class="lines only-lines" />
        </ui:VisualElement>

        <ui:VisualElement name="layout-dialogue" class="layout layout-dialogue">
            <ui:VisualElement class="dialogue-box">
                <ui:VisualElement name="portrait" class="portrait" />
                <ui:VisualElement class="dialogue-col">
                    <ui:Label name="speaker" class="speaker" />
                    <ui:Label name="dialogue-text" class="dialogue-text" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="next" text="v" class="next-indicator" />
        <ui:Label name="skip-hint" text="E / Space: lanjut    Esc: lewati" class="skip-hint" />
    </ui:VisualElement>
</ui:UXML>
